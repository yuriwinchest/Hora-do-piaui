# Copie para .env e preencha. NUNCA commite .env

POSTGRES_HOST=db.SEUPROJETO.supabase.co
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=postgres
SUPABASE_URL=https://SEUPROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://SEUPROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Na VPS: servidor OG (foto da matéria no WhatsApp) usa as duas acima

# SSH para a VPS: use IP ou hostname PÚBLICO do servidor (não localhost nem Docker)
VPS_HOST=
VPS_USER=root
VPS_SSH_KEY_PATH=
VPS_SSH_KEY_PASSPHRASE=

# Nginx (VPS) -> upstream do servidor OG (não commitar .env real)
# Exemplo: http://127.0.0.1:3001
OG_UPSTREAM=http://127.0.0.1:3001

LOCAL_PG_PASSWORD=
