# Copie para .env e preencha. NUNCA commite .env

POSTGRES_HOST=db.SEUPROJETO.supabase.co
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=postgres
SUPABASE_URL=https://SEUPROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://SEUPROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Na VPS: servidor OG (foto da matéria no WhatsApp) usa as duas acima

# SSH para a VPS: use IP ou hostname PÚBLICO do servidor (não localhost nem Docker)
VPS_HOST=
VPS_USER=root
VPS_SSH_KEY_PATH=
VPS_SSH_KEY_PASSPHRASE=

# Nome do service no /opt/traefik/docker-compose.yml (default: traefik)
TRAEFIK_SERVICE_NAME=traefik

# Nginx (VPS) -> upstream do servidor OG (não commitar .env real)
# Exemplo: http://127.0.0.1:3001
OG_UPSTREAM=http://127.0.0.1:3001

# VPS legacy nginx (porta interna, se ainda existir)
LEGACY_PORT=81

# Canary (blue/green) protegido
CANARY_HOST=canary.fatopago.com
# Formato: "user:hash" (bcrypt), pode passar mais de 1 separado por virgula
CANARY_BASIC_AUTH_USERS=
CANARY_DYNAMIC_FILE=/opt/traefik/dynamic.d/90-canary.yml

LOCAL_PG_PASSWORD=
